+def parse_hour(hourmin):
+    hm = int(float(hourmin))
+    # KuaiRand hourmin is an HHMM integer (e.g. 930, 2137).
+    h = hm // 100
+    if h < 0:
+        h = 0
+    if h > 23:
+        h = h % 24
+    return h
+
