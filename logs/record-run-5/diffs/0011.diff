+
+
+def yyyymmdd_to_weekday(d):
+    return datetime.strptime(str(int(d)), '%Y%m%d').weekday()  # Monday=0
+
+
+def encode_with_weekday(splits):
+    enc, dim = encode(splits)
+    out = {}
+    for sp, rows in splits.items():
+        X, y, u = enc[sp]
+        dow = np.asarray([yyyymmdd_to_weekday(r[0]) for r in rows], dtype=np.int64)
+        X2 = np.concatenate([X.astype(np.int64), (dim + dow)[:, None]], axis=1)
+        out[sp] = (X2, y, u)
+    return out, dim + 7
 
 
