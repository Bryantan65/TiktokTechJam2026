+    def aux_scores(self, X):
+        # Tasks 1..n are auxiliary; share the same FM interaction term but have
+        # separate first-order weights/biases.
+        inter = self.shared_interaction(X).view(-1, 1)
+        outs = []
+        for t in range(1, self.n_tasks):
+            outs.append(self.b[t] + self.W[t, X].sum(1))
+        if not outs:
+            return None
+        return inter + torch.stack(outs, dim=1)
 
