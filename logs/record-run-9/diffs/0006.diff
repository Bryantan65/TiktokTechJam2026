+    u = np.asarray(utr)
+    order = np.argsort(u, kind='stable')
+    us = u[order]
+    split = np.flatnonzero(us[1:] != us[:-1]) + 1
+    chunks = np.split(order, split)
+    neg_by_user = {}
+    eligible_pos = []
+    eligible_user = []
+    for rows in chunks:
+        yy = y[rows]
+        pos = rows[yy > 0.5]
