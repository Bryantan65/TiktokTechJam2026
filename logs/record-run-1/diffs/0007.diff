+def find_log_dir(data_dir):
+    cands = [data_dir, os.path.join(data_dir, 'data'), os.path.dirname(data_dir)]
+    for d in cands:
+        if os.path.exists(os.path.join(d, 'log_standard_4_08_to_4_21_pure.csv')):
