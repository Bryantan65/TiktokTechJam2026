+        self.b_aux = torch.nn.Parameter(torch.zeros(n_tasks, dtype=torch.float32))
+
+    def parts(self, X):
         E = self.V[X]
         S = E.sum(1)
         inter = 0.5 * ((S ** 2).sum(1) - (E ** 2).sum((1, 2)))
+        return inter
+
+    def forward(self, X):
+        inter = self.parts(X)
