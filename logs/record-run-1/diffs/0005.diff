+def read_aux(data_dir, total_rows):
+    """Read raw standard logs in canonical order and return aux matrix.
+
+    Columns absent in a particular copy are masked out.  Binary tasks use BCE;
+    play time uses standardized log1p regression if a play-time column exists.
+    """
+    paths = [
+        os.path.join(data_dir, 'log_standard_4_08_to_4_21_pure.csv'),
+        os.path.join(data_dir, 'log_standard_4_22_to_5_08_pure.csv'),
+    ]
+    rows = []
+    seen_cols = None
+    for path in paths:
+        with open(path, 'r', newline='', encoding='utf-8') as f:
+            rdr = csv.DictReader(f)
+            if seen_cols is None:
+                seen_cols = set(rdr.fieldnames or [])
+            else:
+                seen_cols |= set(rdr.fieldnames or [])
+            for rec in rdr:
+                vals = []
+                mask = []
+                for c in BIN_TASKS:
+                    v = _float_or_nan(rec.get(c))
+                    if np.isnan(v):
+                        vals.append(0.0); mask.append(0.0)
+                    else:
+                        vals.append(1.0 if v > 0 else 0.0); mask.append(1.0)
+                pv = np.nan
+                for c in PLAY_COLS:
+                    if c in rec:
+                        pv = _float_or_nan(rec.get(c))
+                        if not np.isnan(pv):
+                            break
+                if np.isnan(pv):
+                    vals.append(0.0); mask.append(0.0)
+                else:
+                    vals.append(np.log1p(max(0.0, pv))); mask.append(1.0)
+                rows.append((vals, mask))
+    if len(rows) < total_rows:
+        raise RuntimeError(f'raw logs have {len(rows)} rows, need at least {total_rows}')
+    rows = rows[:total_rows]
+    aux = np.asarray([r[0] for r in rows], dtype=np.float32)
+    mask = np.asarray([r[1] for r in rows], dtype=np.float32)
+
+    # Standardize play-time target using train rows later would be ideal, but the
+    # global transform is only an auxiliary target and does not use labels/metrics.
+    play_mask = mask[:, -1] > 0.5
+    if play_mask.any():
+        mu = float(aux[play_mask, -1].mean())
+        sd = float(aux[play_mask, -1].std() + 1e-6)
+        aux[play_mask, -1] = (aux[play_mask, -1] - mu) / sd
+    return aux, mask
+
