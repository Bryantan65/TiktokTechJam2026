+def aux_loss_fn(logits, target, mask):
+    # First five tasks are binary feedback, last task is standardized log play time.
+    loss = logits.new_tensor(0.0)
+    denom = logits.new_tensor(0.0)
+    if logits.shape[1] > 1:
+        m = mask[:, :5]
+        if torch.sum(m) > 0:
+            bce = torch.nn.functional.binary_cross_entropy_with_logits(
+                logits[:, :5], target[:, :5], reduction='none')
+            loss = loss + (bce * m).sum()
+            denom = denom + m.sum()
+    m = mask[:, 5]
+    if torch.sum(m) > 0:
+        mse = torch.nn.functional.smooth_l1_loss(logits[:, 5], target[:, 5], reduction='none')
+        # Regression loss is noisier; downweight within the auxiliary block.
+        loss = loss + 0.25 * (mse * m).sum()
+        denom = denom + 0.25 * m.sum()
+    if float(denom.detach().cpu()) <= 0.0:
+        return logits.new_tensor(0.0)
+    return loss / denom.clamp_min(1.0)
+
