+def iter_user_batches(groups, rng, max_rows=8192):
+    order = rng.permutation(len(groups))
+    cur, n = [], 0
+    for gi in order:
+        g = groups[gi]
+        if cur and n + len(g) > max_rows:
+            yield cur
+            cur, n = [], 0
+        cur.append(g)
+        n += len(g)
+    if cur:
+        yield cur
+
