+class Calibrator(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.scale_raw = torch.nn.Parameter(torch.zeros(()))
+        self.bias = torch.nn.Parameter(torch.zeros(()))
+        self.tab = torch.nn.Parameter(torch.zeros(8))
+        self.hour = torch.nn.Parameter(torch.zeros(25))
+        self.part = torch.nn.Parameter(torch.zeros(7))
+        self.dur = torch.nn.Parameter(torch.zeros(32))
+    def forward(self, base, cf):
+        scale = 1.0 + 0.25 * torch.tanh(self.scale_raw)
+        return scale * base + self.bias + self.tab[cf[:,0]] + self.hour[cf[:,1]] + self.part[cf[:,2]] + self.dur[cf[:,3]]
+    @torch.no_grad()
+    def predict_np(self, base, cf, bs=300000, device='cpu'):
+        self.eval(); out=[]
+        for i in range(0, len(base), bs):
+            b=torch.from_numpy(base[i:i+bs].astype(np.float32)).to(device); c=torch.from_numpy(cf[i:i+bs].astype(np.int64)).to(device)
+            out.append(self(b,c).cpu().numpy())
         return np.concatenate(out)
 
 
