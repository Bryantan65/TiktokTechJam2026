+def _add_stat(d, key, y):
+    c, p = d.get(key, (0, 0.0))
+    d[key] = (c + 1, p + float(y))
+
+
+def _rate(d, key, g, prior):
+    c, p = d.get(key, (0, 0.0))
+    return (p + prior * g) / (c + prior)
+
+
+def _logit(p):
+    p = min(max(float(p), 1e-5), 1.0 - 1e-5)
+    return np.log(p / (1.0 - p))
+
+
+def build_eb_scorer(splits):
+    train = splits['train']
+    g = np.mean([r[6] for r in train])
+    base = _logit(g)
+    stats = {name: {} for name in ['v', 'a', 'at', 'ut', 'ud', 'ua', 'uv']}
+    for date, uid, vid, aid, tab, dur, y in train:
+        u, v, a, t, d = str(uid), str(vid), str(aid), int(tab), int(dur)
+        _add_stat(stats['v'], v, y)
+        _add_stat(stats['a'], a, y)
+        _add_stat(stats['at'], (a, t), y)
+        _add_stat(stats['ut'], (u, t), y)
+        _add_stat(stats['ud'], (u, d), y)
+        _add_stat(stats['ua'], (u, a), y)
+        _add_stat(stats['uv'], (u, v), y)
+    print('EB stats:', {k: len(v) for k, v in stats.items()}, 'global', round(float(g), 5))
+
+    def scores(rows):
+        out = np.empty(len(rows), dtype=np.float32)
+        for i, (_date, uid, vid, aid, tab, dur, _y) in enumerate(rows):
+            u, v, a, t, d = str(uid), str(vid), str(aid), int(tab), int(dur)
+            s = 0.0
+            s += 0.25 * (_logit(_rate(stats['v'], v, g, 30.0)) - base)
+            s += 0.35 * (_logit(_rate(stats['a'], a, g, 80.0)) - base)
+            s += 0.25 * (_logit(_rate(stats['at'], (a, t), g, 50.0)) - base)
+            s += 0.55 * (_logit(_rate(stats['ut'], (u, t), g, 20.0)) - base)
+            s += 0.20 * (_logit(_rate(stats['ud'], (u, d), g, 20.0)) - base)
+            s += 0.40 * (_logit(_rate(stats['ua'], (u, a), g, 4.0)) - base)
+            s += 0.15 * (_logit(_rate(stats['uv'], (u, v), g, 2.0)) - base)
+            out[i] = s
+        return out
+    return scores
+
+
+def blend_scores(fm, eb, alpha=0.30):
+    eb = eb.astype(np.float64)
+    fm = fm.astype(np.float64)
+    es = eb.std()
+    fs = fm.std()
+    if es < 1e-8 or fs < 1e-8:
+        return fm
+    return fm + alpha * fs * ((eb - eb.mean()) / es)
 
 
