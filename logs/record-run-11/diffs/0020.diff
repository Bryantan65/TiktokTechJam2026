+def make_lgb_features(base, users, X, calfeat):
+    # [continuous base features, categorical context/item fields]
+    n = len(base); base = base.astype(np.float32)
+    z = np.zeros(n, dtype=np.float32); rk = np.zeros(n, dtype=np.float32)
+    mp = defaultdict(list)
+    for i, u in enumerate(users): mp[u].append(i)
+    for idxs in mp.values():
+        idx = np.asarray(idxs, dtype=np.int64); b = base[idx]; sd = float(b.std())
+        z[idx] = (b - float(b.mean())) / (sd + 1e-6)
+        o = np.argsort(-b, kind='mergesort'); rr = np.empty(len(idx), dtype=np.float32); rr[o] = np.arange(len(idx), dtype=np.float32) / max(len(idx)-1, 1)
+        rk[idx] = rr
+    # X columns: user, video, author, tab, dur_bucket, weekday, hour, daypart after augmentation
+    feats = np.column_stack([
+        base, z, rk,
+        X[:,1].astype(np.int32), X[:,2].astype(np.int32), X[:,3].astype(np.int32), X[:,4].astype(np.int32),
+        calfeat[:,0].astype(np.int32), calfeat[:,1].astype(np.int32), calfeat[:,2].astype(np.int32), calfeat[:,3].astype(np.int32)
+    ]).astype(np.float32)
+    return feats
 
 
