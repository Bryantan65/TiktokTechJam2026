+class LambdaResidual:
+    def __init__(self, seed=0, weight=0.35):
+        self.seed = seed; self.weight = weight; self.model = None; self.scale = 0.0; self.mean = 0.0
+    def fit(self, base, y, users, X, calfeat):
+        import lightgbm as lgb
+        F = make_lgb_features(base, users, X, calfeat)
+        order = np.argsort(users, kind='mergesort')
+        us = np.asarray(users)[order]
+        _, counts = np.unique(us, return_counts=True)
+        Fs = F[order]; ys = y[order].astype(np.int32)
+        self.model = lgb.LGBMRanker(objective='lambdarank', metric='ndcg', eval_at=[5], label_gain=[0, 1],
+                                    n_estimators=90, learning_rate=0.045, num_leaves=31, max_depth=-1,
+                                    min_child_samples=80, subsample=0.85, subsample_freq=1, colsample_bytree=0.90,
+                                    reg_lambda=1.5, random_state=self.seed, n_jobs=2, verbosity=-1)
+        cat = [3,4,5,6,7,8,9,10]
+        self.model.fit(Fs, ys, group=counts.tolist(), categorical_feature=cat)
+        raw = self.model.predict(F, num_iteration=self.model.best_iteration_).astype(np.float32)
+        self.mean = float(raw.mean())
+        sb = float(np.std(base)); sr = float(np.std(raw))
+        self.scale = self.weight * sb / (sr + 1e-6)
+        print(f"LambdaResidual: raw_std={sr:.5f} base_std={sb:.5f} scale={self.scale:.5f}")
+        return self
+    def predict(self, base, users, X, calfeat):
+        if self.model is None: return base
+        F = make_lgb_features(base, users, X, calfeat)
+        raw = self.model.predict(F, num_iteration=self.model.best_iteration_).astype(np.float32)
+        return base + self.scale * (raw - self.mean)
+
