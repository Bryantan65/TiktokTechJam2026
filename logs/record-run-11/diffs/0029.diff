+def user_rank_score(scores, users):
+    """Return per-user rank scores: best item near +1, worst near -1."""
+    scores = np.asarray(scores, dtype=np.float32)
+    out = np.empty_like(scores, dtype=np.float32)
+    mp = defaultdict(list)
+    for i, u in enumerate(users):
+        mp[u].append(i)
+    for idxs in mp.values():
+        idx = np.asarray(idxs, dtype=np.int64)
+        s = scores[idx]
+        o = np.argsort(-s, kind='mergesort')
+        r = np.empty(len(idx), dtype=np.float32)
+        if len(idx) <= 1:
+            r[o] = 0.0
+        else:
+            # 1.0 for the top item, -1.0 for the bottom item.
+            r[o] = 1.0 - 2.0 * (np.arange(len(idx), dtype=np.float32) / float(len(idx) - 1))
+        out[idx] = r
+    return out
+
