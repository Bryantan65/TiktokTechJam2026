+def per_user_rank_average(preds, users):
+    P = np.vstack(preds).astype(np.float64)
+    users = np.asarray(users)
+    out = np.zeros(P.shape[1], dtype=np.float64)
+    order = np.argsort(users, kind='mergesort')
+    su = users[order]
+    start = 0
+    while start < len(order):
+        end = start + 1
+        while end < len(order) and su[end] == su[start]: end += 1
+        idx = order[start:end]; n = end - start
+        if n <= 1:
+            out[idx] = P[:, idx].mean(0)
+        else:
+            acc = np.zeros(n, dtype=np.float64)
+            for m in range(P.shape[0]):
+                vals = P[m, idx]
+                r = np.empty(n, dtype=np.float64)
+                r[np.argsort(vals, kind='mergesort')] = np.arange(n, dtype=np.float64)
+                acc += r / (n - 1.0)
+            out[idx] = acc / P.shape[0]
+        start = end
+    return out
