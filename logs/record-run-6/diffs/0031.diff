+def make_bpr_pairs(users_b, y_b, rng, max_pairs=MAX_BPR_PAIRS):
+    users_b = np.asarray(users_b); y_b = np.asarray(y_b)
+    order = np.argsort(users_b, kind='mergesort'); su = users_b[order]
+    pos_all = []; neg_all = []; start = 0
+    while start < len(order):
+        end = start + 1
+        while end < len(order) and su[end] == su[start]: end += 1
+        idx = order[start:end]; yy = y_b[idx]
+        pos = idx[yy > 0.5]; neg = idx[yy <= 0.5]
+        if len(pos) and len(neg):
+            m = min(len(pos), len(neg), 4)
+            if len(pos) > m: pos = rng.choice(pos, size=m, replace=False)
+            if len(neg) > m: neg = rng.choice(neg, size=m, replace=False)
+            if len(pos) != len(neg):
+                mm = min(len(pos), len(neg)); pos = pos[:mm]; neg = neg[:mm]
+            pos_all.append(pos); neg_all.append(neg)
+            if sum(len(x) for x in pos_all) >= max_pairs: break
+        start = end
+    if not pos_all:
+        return None, None
+    p = np.concatenate(pos_all)[:max_pairs]; n = np.concatenate(neg_all)[:max_pairs]
+    return p.astype(np.int64), n.astype(np.int64)
