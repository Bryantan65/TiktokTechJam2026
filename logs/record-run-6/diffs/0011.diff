+def _date_parts(date_int):
+    try:
+        dt = datetime.strptime(str(int(date_int)), '%Y%m%d')
+        return dt.weekday(), dt.timetuple().tm_yday
+    except Exception:
+        return 0, 0
+
+
+def read_time_features(data_dir, splits):
+    """Return split -> int matrix [date, weekday, day_index, hour, block]."""
+    raw = []
+    for path in _raw_log_paths(data_dir):
+        if not os.path.exists(path):
+            continue
+        with open(path, 'r', newline='', encoding='utf-8') as f:
+            for r in csv.DictReader(f):
+                date = _to_int(r.get('date'))
+                hm = _to_int(r.get('hourmin'), 0)
+                hour = max(0, min(23, hm // 100))
+                weekday, yday = _date_parts(date)
+                block = hour // 4
+                raw.append((date, weekday, yday, hour, block))
+    need = sum(len(splits[sp]) for sp in ('train', 'valid', 'test'))
+    if len(raw) != need:
+        print(f"warning: raw time row count {len(raw)} != loaded rows {need}; falling back where missing")
+    out, off = {}, 0
+    for sp in ('train', 'valid', 'test'):
+        n = len(splits[sp])
+        arr = np.zeros((n, 5), dtype=np.int64)
+        m = max(0, min(n, len(raw) - off))
+        if m:
+            arr[:m] = np.asarray(raw[off:off + m], dtype=np.int64)
+        for i in range(m, n):
+            date = int(splits[sp][i][0])
+            weekday, yday = _date_parts(date)
+            arr[i] = (date, weekday, yday, 0, 0)
+        out[sp] = arr
+        off += n
+    return out
+
+
+def add_time_fields(enc, splits, data_dir):
+    times = read_time_features(data_dir, splits)
+    Xtr, ytr, utr = enc['train']
+    offset = int(max(v[0].max() for v in enc.values())) + 1
+    maps = []
+    # date and exact day are mostly overlapping; keep both absolute date and
+    # weekday/hour/block because each has different sharing across days.
+    for j in range(times['train'].shape[1]):
+        vals = np.unique(times['train'][:, j])
+        mp = {int(v): offset + i + 1 for i, v in enumerate(vals)}
+        unk = offset
+        maps.append((mp, unk))
+        offset += len(vals) + 1
+    out = {}
+    for sp, (X, y, u) in enc.items():
+        extra = np.zeros((len(X), len(maps)), dtype=np.int64)
+        for j, (mp, unk) in enumerate(maps):
+            col = times[sp][:, j]
+            extra[:, j] = [mp.get(int(v), unk) for v in col]
+        out[sp] = (np.concatenate([X.astype(np.int64), extra], axis=1), y, u)
+    return out, offset
+
