+def fit_prior_ranker(enc):
+    Xtr, ytr, _ = enc['train']
+    ytr = ytr.astype(np.float64)
+    dim = int(Xtr.max()) + 1
+    global_rate = float(ytr.mean())
+    eps = 1e-6
+    g_logit = np.log(np.clip(global_rate, eps, 1 - eps) /
+                     np.clip(1 - global_rate, eps, 1 - eps))
+
+    # Encoded columns: user, video, author, tab, duration bucket.  Do not use
+    # user priors: user-only terms cannot affect within-user ranking.
+    specs = [
+        (1, 80.0, 1.00),   # video_id: many sparse ids, heavy smoothing
+        (2, 40.0, 0.65),   # author_id
+        (3, 200.0, 0.55),  # tab: robust context prior
+        (4, 200.0, 0.25),  # duration bucket
+    ]
+    tables = []
+    for col, smooth, weight in specs:
+        ids = Xtr[:, col].astype(np.int64)
+        cnt = np.bincount(ids, minlength=dim).astype(np.float64)
+        sm = np.bincount(ids, weights=ytr, minlength=dim).astype(np.float64)
+        rate = (sm + smooth * global_rate) / (cnt + smooth)
+        logit = np.log(np.clip(rate, eps, 1 - eps) /
+                       np.clip(1 - rate, eps, 1 - eps)) - g_logit
+        # unseen ids have exactly the global prior, hence zero contribution
+        logit[cnt <= 0] = 0.0
+        tables.append((col, weight, logit.astype(np.float32)))
+    return tables
+
+
+def prior_scores(X, tables):
+    out = np.zeros(len(X), dtype=np.float64)
+    for col, weight, table in tables:
+        ids = X[:, col].astype(np.int64)
+        ok = ids < len(table)
+        contrib = np.zeros(len(X), dtype=np.float64)
+        contrib[ok] = table[ids[ok]]
+        out += weight * contrib
+    return out
+
