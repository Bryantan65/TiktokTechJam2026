+def train_ensemble(splits, k=16, lr=0.001, epochs=40, seed=0,
+                   device='cpu', verbose=True):
+    enc, dim = encode(splits)
+    # Deterministic offsets keep harness seeds distinct while producing a true
+    # three-member ensemble for each requested seed.
+    seeds = [seed, seed + 1009, seed + 2027]
+    models, scales = [], []
+    for j, s in enumerate(seeds):
+        torch.manual_seed(s)
+        m, sc = train_one(enc, dim, k=k, lr=lr, epochs=epochs, seed=s,
+                          device=device, verbose=verbose, tag=f"m{j+1}/3")
+        models.append(m)
+        scales.append(sc)
+    return models, scales, enc
+
+
+@torch.no_grad()
+def ensemble_predict(models, scales, X, device='cpu'):
+    pred = np.zeros(len(X), dtype=np.float64)
+    for m, sc in zip(models, scales):
+        pred += m.predict(X, device=device).astype(np.float64) / sc
+    pred /= len(models)
+    return pred
 
 
