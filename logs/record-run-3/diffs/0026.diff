+def _add_stat(d, key, y):
+    p, n = d.get(key, (0.0, 0.0)); d[key] = (p + float(y), n + 1.0)
+
+
+def _logit_stat(d, key, base_p, prior):
+    p, n = d.get(key, (0.0, 0.0))
+    if n <= 0: return 0.0
+    q = (p + prior * base_p) / (n + prior)
+    q = min(max(q, 1e-4), 1.0 - 1e-4)
+    b = min(max(base_p, 1e-4), 1.0 - 1e-4)
+    return math.log(q / (1.0 - q)) - math.log(b / (1.0 - b))
+
+
+def build_history_prior(splits, split):
+    uv, ua, ut, ud, vv, aa, tt = {}, {}, {}, {}, {}, {}, {}
+    train = splits['train']
+    base_p = (sum(float(r[6]) for r in train) + 1.0) / (len(train) + 2.0)
+    for r in train:
+        u, v, a, tab, dur, y = _to_int(r[1]), _to_int(r[2]), _to_int(r[3]), _to_int(r[4]), _to_int(r[5]), _to_int(r[6])
+        db = min(dur // 10000, 60)
+        _add_stat(uv, (u, v), y); _add_stat(ua, (u, a), y); _add_stat(ut, (u, tab), y); _add_stat(ud, (u, db), y)
+        _add_stat(vv, v, y); _add_stat(aa, a, y); _add_stat(tt, tab, y)
+    rows = splits[split]; out = np.zeros(len(rows), dtype=np.float64)
+    for i, r in enumerate(rows):
+        u, v, a, tab, dur = _to_int(r[1]), _to_int(r[2]), _to_int(r[3]), _to_int(r[4]), _to_int(r[5])
+        db = min(dur // 10000, 60)
+        s = 0.0
+        s += 2.0 * _logit_stat(uv, (u, v), base_p, 2.0)
+        s += 1.2 * _logit_stat(ua, (u, a), base_p, 5.0)
+        s += 0.6 * _logit_stat(ut, (u, tab), base_p, 10.0)
+        s += 0.5 * _logit_stat(ud, (u, db), base_p, 10.0)
+        s += 0.35 * _logit_stat(vv, v, base_p, 20.0)
+        s += 0.25 * _logit_stat(aa, a, base_p, 20.0)
+        s += 0.15 * _logit_stat(tt, tab, base_p, 50.0)
+        out[i] = s
+    return out
+
