+class UserHistoryPrior:
+    def __init__(self, enc):
+        Xtr, ytr, users = enc['train']
+        ytr = ytr.astype(np.float64)
+        self.global_rate = float(ytr.mean())
+        self.user_sum = defaultdict(float)
+        self.user_cnt = defaultdict(int)
+        self.tables = []
+
+        # Build smoothed per-user feature feedback tables from train only.  The
+        # encoded columns are [user, video, author, tab, dur_bucket].
+        specs = [
+            (1, 1.0, 1.35),   # repeated/previously seen video for this user
+            (2, 4.0, 0.85),   # author affinity
+            (3, 12.0, 0.45),  # tab preference
+            (4, 18.0, 0.20),  # duration preference
+        ]
+        sums = [defaultdict(float) for _ in specs]
+        cnts = [defaultdict(int) for _ in specs]
+        for row, yy, u in zip(Xtr, ytr, users):
+            u = int(u)
+            self.user_sum[u] += float(yy)
+            self.user_cnt[u] += 1
+            for j, (col, _smooth, _weight) in enumerate(specs):
+                key = (u, int(row[col]))
+                sums[j][key] += float(yy)
+                cnts[j][key] += 1
+        self.specs = specs
+        self.sums = sums
+        self.cnts = cnts
+
+    @staticmethod
+    def _logit(p):
+        p = min(max(float(p), 1e-5), 1.0 - 1e-5)
+        return np.log(p / (1.0 - p))
+
+    def score(self, X, users):
+        out = np.zeros(len(X), dtype=np.float64)
+        g = self.global_rate
+        for i, (row, u0) in enumerate(zip(X, users)):
+            u = int(u0)
+            # Center by the user's own train rate so heavy/light users do not
+            # get a constant offset; only feature-specific deviations rank rows.
+            uc = self.user_cnt.get(u, 0)
+            ur = (self.user_sum.get(u, 0.0) + 20.0 * g) / (uc + 20.0)
+            base = self._logit(ur)
+            s = 0.0
+            for j, (col, smooth, weight) in enumerate(self.specs):
+                key = (u, int(row[col]))
+                c = self.cnts[j].get(key, 0)
+                sm = self.sums[j].get(key, 0.0)
+                # Smooth to this user's baseline, not global, to make the prior
+                # a personalized history-affinity residual.
+                r = (sm + smooth * ur) / (c + smooth)
+                s += weight * (self._logit(r) - base)
+            out[i] = s
+        return out
+
