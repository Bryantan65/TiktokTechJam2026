+def blended_predict(models, hist_prior, X, users, device='cpu', alpha=0.94):
+    bpr = bpr_ensemble_rank(models, X, users, device=device)
+    hp = within_user_rank_scores(hist_prior.score(X, users), users)
+    return alpha * bpr + (1.0 - alpha) * hp
 
 
