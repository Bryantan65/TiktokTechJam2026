+def make_value_pairs(values, users):
+    values = np.asarray(values); users = np.asarray(users)
+    order = np.argsort(users, kind='mergesort')
+    su = users[order]
+    starts = np.r_[0, np.flatnonzero(su[1:] != su[:-1]) + 1]
+    ends = np.r_[starts[1:], len(order)]
+    hi_lists, lo_lists, n_hi = [], [], 0
+    for s, e in zip(starts, ends):
+        idx = order[s:e]
+        vals = values[idx]
+        if len(idx) < 2 or float(vals.max() - vals.min()) < 1e-6:
+            continue
+        med = np.median(vals)
+        hi = idx[vals > med]
+        lo = idx[vals <= med]
+        if len(hi) == 0 or len(lo) == 0:
+            # fall back to strict max-vs-rest for tiny/tied groups
+            hi = idx[vals == vals.max()]
+            lo = idx[vals < vals.max()]
+        if len(hi) and len(lo):
+            hi_lists.append(hi.astype(np.int64)); lo_lists.append(lo.astype(np.int64)); n_hi += len(hi)
+    return hi_lists, lo_lists, n_hi
+
