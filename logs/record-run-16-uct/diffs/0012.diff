+def per_user_z(pred, groups):
+    out = np.empty_like(pred, dtype=np.float64)
+    for idx in groups:
         vals = pred[idx]
         sd = vals.std()
         if sd > 1e-12:
             out[idx] = (vals - vals.mean()) / sd
         else:
             out[idx] = 0.0
+    return out
