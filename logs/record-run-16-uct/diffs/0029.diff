+def _norm_num(x):
+    try:
+        return str(int(float(x)))
+    except Exception:
+        return str(x)
+
+
+def _row_key(row):
+    return (str(row[0]), str(row[1]), str(row[2]), str(row[3]), str(row[4]), _norm_num(row[5]))
+
+
+def _csv_key(rec):
+    def get(*names):
+        for n in names:
+            if n in rec:
+                return rec[n]
+        return ''
+    return (str(get('date')), str(get('user_id', 'user')), str(get('video_id', 'photo_id', 'item_id')),
+            str(get('author_id')), str(get('tab')), _norm_num(get('duration_ms', 'duration')))
+
+
+def _parse_hour(x):
+    if x is None:
+        return -1
+    s = str(x).strip()
+    if not s:
+        return -1
+    try:
+        if ':' in s:
+            return int(s.split(':')[0]) % 24
+        v = int(float(s))
+        if v >= 100:
+            return (v // 100) % 24
+        return v % 24
+    except Exception:
+        return -1
+
+
+def _weekday(date_val):
+    try:
+        s = str(int(date_val))
+        return _dt.datetime.strptime(s, '%Y%m%d').weekday()
+    except Exception:
+        return -1
+
+
+def load_time_extras(data_dir, splits):
+    """Return {(split,row_index): (hour_bucket, weekday)} by joining raw CSV rows."""
+    files = ['log_standard_4_08_to_4_21_pure.csv', 'log_standard_4_22_to_5_08_pure.csv']
+    q = defaultdict(deque)
+    for fn in files:
+        path = os.path.join(data_dir, fn)
+        if not os.path.isfile(path):
+            continue
+        try:
+            with open(path, newline='', encoding='utf-8') as f:
+                rd = csv.DictReader(f)
+                for rec in rd:
+                    hm = rec.get('hourmin', rec.get('hour_min', rec.get('time', '')))
+                    h = _parse_hour(hm)
+                    hb = h // 4 if h >= 0 else -1
+                    d = rec.get('date', '')
+                    q[_csv_key(rec)].append((hb, _weekday(d)))
+        except Exception:
+            continue
+    extras = {}
+    for sp, rows in splits.items():
+        arr = []
+        for row in rows:
+            dq = q.get(_row_key(row))
+            if dq and len(dq):
+                arr.append(dq.popleft())
+            else:
+                arr.append((-1, _weekday(row[0])))
+        extras[sp] = arr
+    return extras
+
