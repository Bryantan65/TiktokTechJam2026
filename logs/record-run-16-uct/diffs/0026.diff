+def duration_bucket(duration_ms):
+    try:
+        d = float(duration_ms)
+    except Exception:
+        d = 0.0
+    # Coarse buckets to avoid sparse exact-duration memorization.
+    if d < 5_000:
+        return 0
+    if d < 10_000:
+        return 1
+    if d < 20_000:
+        return 2
+    if d < 40_000:
+        return 3
+    if d < 80_000:
+        return 4
+    if d < 160_000:
+        return 5
+    return 6
