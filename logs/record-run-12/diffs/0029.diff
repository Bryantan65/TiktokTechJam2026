+def make_quality_prior(splits, target, content):
+    y=np.array([r[6] for r in splits['train']],dtype=np.float64); global_mean=float(y.mean())
+    specs=[
+        ('video', lambda r: norm_val(r[2]), 25.0, 1.60),
+        ('author', lambda r: norm_val(r[3]), 50.0, 1.10),
+        ('tag', lambda r: content.get(norm_val(r[2]),('__MISS__',)*7)[1], 80.0, 0.70),
+        ('music', lambda r: content.get(norm_val(r[2]),('__MISS__',)*7)[0], 60.0, 0.55),
+        ('tab', lambda r: norm_val(r[4]), 200.0, 0.30),
+        ('dur', lambda r: str(int(float(r[5])//10000)), 100.0, 0.25),
+    ]
+    maps=[]
+    for name,fn,alpha,wt in specs:
+        d={}
+        for r in splits['train']:
+            k=fn(r); n,s=d.get(k,(0,0.0)); d[k]=(n+1,s+float(r[6]))
+        maps.append((name,fn,alpha,wt,d)); print('quality map',name,'keys',len(d))
+    raw=np.empty(len(splits[target]),dtype=np.float64); strength=np.empty(len(splits[target]),dtype=np.float64)
+    for i,r in enumerate(splits[target]):
+        num=0.0; den=0.0; st=0.0
+        for name,fn,alpha,wt,d in maps:
+            n,s=d.get(fn(r),(0,0.0)); rate=(s+alpha*global_mean)/(n+alpha); shrink=n/(n+alpha)
+            num += wt*shrink*rate; den += wt*shrink; st += wt*shrink
+        raw[i]=global_mean if den<=0 else num/den; strength[i]=st
+    print('quality prior mean/std/coverage/strength',float(raw.mean()),float(raw.std()),float((strength>0).mean()),float(strength.mean()))
