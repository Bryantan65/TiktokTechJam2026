+def parse_hourmin(v):
+    try:
+        x = int(float(str(v).strip()))
+    except Exception:
+        return -1, -1
+    h = x // 100
+    m = x % 100
+    if h < 0 or h > 23 or m < 0 or m > 59:
+        return -1, -1
+    return h, m
+
+
+def day_of_week(date_val):
+    try:
+        return datetime.strptime(str(int(date_val)), '%Y%m%d').weekday()
+    except Exception:
+        return -1
+
+
+def row_key(r):
+    return (str(r[0]), str(r[1]), str(r[2]), str(r[3]), str(r[4]), str(r[5]))
+
+
+def raw_key(rec):
+    return (norm_val(rec.get('date')), norm_val(rec.get('user_id')), norm_val(rec.get('video_id')),
+            norm_val(rec.get('author_id')), norm_val(rec.get('tab')), norm_val(rec.get('duration_ms')))
+
+
+def load_raw_times(data_dir):
+    files = ['log_standard_4_08_to_4_21_pure.csv', 'log_standard_4_22_to_5_08_pure.csv']
+    mp = defaultdict(list)
+    total = 0
+    for fn in files:
+        path = os.path.join(data_dir, fn)
+        if not os.path.isfile(path):
+            print('WARNING: missing raw log', path)
+            continue
+        with open(path, newline='', encoding='utf-8') as f:
+            rdr = csv.DictReader(f)
+            for rec in rdr:
+                h, m = parse_hourmin(rec.get('hourmin', ''))
+                mp[raw_key(rec)].append((h, m))
+                total += 1
+    print('loaded raw hour rows', total, 'unique keys', len(mp))
+    return mp
+
+
+def attach_times(splits, data_dir):
+    raw = load_raw_times(data_dir)
+    ptr = defaultdict(int)
+    out = {}
+    miss = 0; seen = 0
+    for sp in ['train', 'valid', 'test']:
+        if sp not in splits:
+            continue
+        arr = np.empty((len(splits[sp]), 5), dtype=np.int16)
+        for i, r in enumerate(splits[sp]):
+            k = row_key(r); j = ptr[k]
+            if j < len(raw.get(k, [])):
+                h, m = raw[k][j]; ptr[k] += 1
+            else:
+                h, m = -1, -1; miss += 1
+            dow = day_of_week(r[0])
+            coarse = (h // 4) if h >= 0 else -1
+            quarter = (h * 4 + m // 15) if h >= 0 else -1
+            weekend = 1 if dow in (5, 6) else (0 if dow >= 0 else -1)
+            arr[i] = (h, coarse, quarter, dow, weekend)
+            seen += 1
+        out[sp] = arr
+    print('time join missing', miss, 'of', seen)
+    return out
+
+
+def fit_time_prior(train_rows, y, train_time):
+    y = np.asarray(y, dtype=np.float64)
+    mu = float(y.mean())
+    eps = 1e-6
+    def logit(p):
+        p = min(max(p, eps), 1.0 - eps)
+        return math.log(p / (1.0 - p))
+    global_logit = logit(mu)
+
+    sums = defaultdict(lambda: [0.0, 0.0])
+    def add(key, val):
+        sums[key][0] += val; sums[key][1] += 1.0
+    for r, yy, tt in zip(train_rows, y, train_time):
+        user = str(r[1]); tab = str(r[4]); durb = str(r[5])
+        h, coarse, quarter, dow, weekend = [int(x) for x in tt]
+        add(('h', h), yy); add(('c', coarse), yy); add(('q', quarter), yy); add(('dow', dow), yy)
+        add(('htab', h, tab), yy); add(('qtab', quarter, tab), yy); add(('cdur', coarse, durb), yy)
+        add(('u_c', user, coarse), yy); add(('u_h', user, h), yy)
+    # Different smoothing strengths: user-specific cells are sparse, so shrink hard.
+    smooth = {'h': 200.0, 'c': 200.0, 'q': 150.0, 'dow': 500.0, 'htab': 120.0, 'qtab': 80.0, 'cdur': 120.0, 'u_c': 8.0, 'u_h': 5.0}
+    table = {}
+    for key, (s, n) in sums.items():
+        lam = smooth.get(key[0], 100.0)
+        p = (s + lam * mu) / (n + lam)
+        table[key] = logit(p) - global_logit
+    return mu, global_logit, table
+
+
+def predict_time_prior(rows, tarr, prior):
+    mu, global_logit, table = prior
+    scores = np.empty(len(rows), dtype=np.float64)
+    for i, (r, tt) in enumerate(zip(rows, tarr)):
+        user = str(r[1]); tab = str(r[4]); durb = str(r[5])
+        h, coarse, quarter, dow, weekend = [int(x) for x in tt]
+        s = global_logit
+        # Mostly global time context, with a small user temporal residual.
+        s += 0.22 * table.get(('h', h), 0.0)
+        s += 0.14 * table.get(('q', quarter), 0.0)
+        s += 0.12 * table.get(('dow', dow), 0.0)
+        s += 0.20 * table.get(('htab', h, tab), 0.0)
+        s += 0.12 * table.get(('qtab', quarter, tab), 0.0)
+        s += 0.08 * table.get(('cdur', coarse, durb), 0.0)
+        s += 0.08 * table.get(('u_c', user, coarse), 0.0)
+        s += 0.04 * table.get(('u_h', user, h), 0.0)
+        scores[i] = s
+    return scores
+
