+def _norm_key_value(x):
+    s = str(x).strip()
+    if s == '':
+        return s
+    try:
+        f = float(s)
+        if np.isfinite(f) and abs(f - round(f)) < 1e-6:
+            return str(int(round(f)))
+    except Exception:
+        pass
+    return s
+
+
+def _first_present(row, names, default=''):
+    for n in names:
+        if n in row and row[n] != '':
+            return row[n]
+    return default
+
+
+def _row_key_from_tuple(r):
+    return tuple(_norm_key_value(v) for v in r[:6])
+
+
+def _row_key_from_csv(rec):
+    return (
+        _norm_key_value(_first_present(rec, ['date', 'request_date', 'day'])),
+        _norm_key_value(_first_present(rec, ['user_id', 'userId'])),
+        _norm_key_value(_first_present(rec, ['video_id', 'videoId', 'photo_id'])),
+        _norm_key_value(_first_present(rec, ['author_id', 'authorId'])),
+        _norm_key_value(_first_present(rec, ['tab'])),
+        _norm_key_value(_first_present(rec, ['duration_ms', 'video_duration', 'duration'])),
+    )
+
+
+def load_play_time_weights(data_dir, train_rows, verbose=True):
+    """Return a per-training-row weight using raw CSV play_time_ms.
+
+    Matching is by the six fields exposed by data.load, with a deque per key so
+    duplicated impressions preserve file-order multiplicity. If the raw files
+    are unavailable or the join mostly misses, fall back to all-ones weights.
+    """
+    raw_files = [
+        os.path.join(data_dir, 'log_standard_4_08_to_4_21_pure.csv'),
+        os.path.join(data_dir, 'log_standard_4_22_to_5_08_pure.csv'),
+    ]
+    by_key = defaultdict(deque)
+    found_any = False
+    for path in raw_files:
+        if not os.path.isfile(path):
+            continue
+        with open(path, newline='', encoding='utf-8') as f:
+            reader = csv.DictReader(f)
+            for rec in reader:
+                found_any = True
+                key = _row_key_from_csv(rec)
+                play_s = _first_present(rec, ['play_time_ms', 'play_ms', 'play_time'], '0')
+                try:
+                    play = float(play_s)
+                except Exception:
+                    play = 0.0
+                by_key[key].append(play)
+    if not found_any:
+        if verbose:
+            print('raw log CSVs not found; using unit watch weights')
+        return np.ones(len(train_rows), dtype=np.float32)
+
+    plays = np.zeros(len(train_rows), dtype=np.float32)
+    matched = 0
+    for i, r in enumerate(train_rows):
+        q = by_key.get(_row_key_from_tuple(r))
+        if q:
+            plays[i] = q.popleft()
+            matched += 1
+
+    match_rate = matched / max(1, len(train_rows))
+    if verbose:
+        print(f'watch-time join matched {matched:,d}/{len(train_rows):,d} rows ({match_rate:.1%})')
+    if match_rate < 0.80:
+        if verbose:
+            print('watch-time join too sparse; using unit watch weights')
+        return np.ones(len(train_rows), dtype=np.float32)
+
+    # Smooth, clipped intensity.  A convex combination with 1.0 keeps the BPR
+    # objective close to node 2 while emphasizing the clearest positive signals.
+    raw = np.log1p(np.minimum(np.maximum(plays, 0.0), 300_000.0) / 1000.0).astype(np.float32)
+    mean_pos = raw[raw > 0].mean() if np.any(raw > 0) else 1.0
+    norm = np.clip(raw / max(float(mean_pos), 1e-6), 0.25, 3.0)
+    weights = (0.5 + 0.5 * norm).astype(np.float32)
+    return weights
+
