+def lambda_epoch_pairs(model,Xtr,groups,seed,ep,device):
+    scores=model.predict(Xtr,bs=200000,device=device); rng=np.random.default_rng(seed+100003*ep)
+    pi=[]; ni=[]; ww=[]; disc=1.0/np.log2(np.arange(2,256,dtype=np.float64))
+    hardp=min(0.80,0.15+0.10*ep)
+    for idx,pos,neg in groups:
+        ss=scores[idx]; ordidx=idx[np.argsort(-ss,kind='mergesort')]
+        rank={int(v):r for r,v in enumerate(ordidx)}
+        nscore=scores[neg]; hard=neg[np.argsort(-nscore,kind='mergesort')[:min(8,len(neg))]]
+        for p in pos:
+            n=int(hard[rng.integers(0,len(hard))]) if rng.random()<hardp else int(neg[rng.integers(0,len(neg))])
+            rp=min(rank.get(int(p),255),254); rn=min(rank.get(n,255),254)
+            d=abs(disc[rp]-disc[rn]) if (rp<5 or rn<5) else 0.04
+            # Emphasise misordered/top-negative pairs while retaining GAUC pressure on all pairs.
+            ww.append(0.25+4.0*d+(1.0 if rn<rp else 0.0)*0.25); pi.append(int(p)); ni.append(n)
+    return np.asarray(pi,dtype=np.int64),np.asarray(ni,dtype=np.int64),np.asarray(ww,dtype=np.float32)
+
+def train_lambda_ndcg_bpr(enc,dim,seed=0,k=16,lr=0.001,l2=1e-6,epochs=10,bs=8192,patience=3,bce_weight=0.05,device='cpu',verbose=False):
