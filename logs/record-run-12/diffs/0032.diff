+    Xt=torch.from_numpy(Xtr.astype(np.int64)); groups=make_groups(ytr,utr); rng=np.random.default_rng(seed+555); best=-1; state=None; bad=0
+    for ep in range(1,epochs+1):
+        pi,ni,wt=lambda_epoch_pairs(model,Xtr,groups,seed,ep,device); perm=rng.permutation(len(pi)); model.train(); losses=[]
+        for i in range(0,len(perm),bs):
+            sel=perm[i:i+bs]; pidx=pi[sel]; nidx=ni[sel]
+            xb=torch.cat([Xt[torch.from_numpy(pidx)],Xt[torch.from_numpy(nidx)]],0).to(device); m=len(pidx); w=torch.from_numpy(wt[sel]).to(device)
+            opt.zero_grad(set_to_none=True); logits=model(xb); pair=F.softplus(-(logits[:m]-logits[m:]))
