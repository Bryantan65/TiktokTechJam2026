+def per_user_zscore(scores, users):
+    scores = scores.astype(np.float64, copy=False)
+    out = np.empty_like(scores, dtype=np.float64)
+    groups = defaultdict(list)
+    for i, u in enumerate(users):
+        groups[u].append(i)
+    for idxs in groups.values():
+        idx = np.asarray(idxs, dtype=np.int64)
+        s = scores[idx]
+        sd = s.std()
+        if sd > 1e-12:
+            out[idx] = (s - s.mean()) / sd
+        else:
+            out[idx] = s - s.mean()
+    return out
+
+
+def cached_predict(member_name, train_fn, enc, dim, target, seed, device, use_cache=True):
+    os.makedirs('pred_cache', exist_ok=True)
+    X, y, users = enc[target]
+    cache_path = os.path.join('pred_cache', f'006_{member_name}_{target}_seed{seed}.npy')
+    if use_cache and os.path.isfile(cache_path):
+        preds = np.load(cache_path)
+        if len(preds) == len(X):
+            return preds
+    model = train_fn()
+    preds = model.predict(X, device=device).astype(np.float64)
+    if use_cache:
+        np.save(cache_path, preds)
+    return preds
 
 
