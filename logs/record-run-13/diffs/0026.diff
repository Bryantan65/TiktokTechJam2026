+def group_sort(X, y, users):
+    u = np.asarray(users)
+    order = np.argsort(u, kind='mergesort')
+    us = u[order]
+    if len(us) == 0: return X, y, []
+    cuts = np.r_[0, np.flatnonzero(us[1:] != us[:-1]) + 1, len(us)]
+    group = np.diff(cuts).astype(int).tolist()
+    return X[order], y[order].astype(np.int32), group
+
+
+def add_ctr_features(enc):
+    Xtr, ytr, _ = enc['train']
+    gmean = float(np.mean(ytr)); out = {}
+    cat_cols = list(range(min(8, Xtr.shape[1])))
+    single_cols = [1, 2, 3, 4, 5, 6, 7] if Xtr.shape[1] >= 8 else list(range(1, Xtr.shape[1]))
+    pair_cols = [(2,3), (2,7), (1,7), (3,7)] if Xtr.shape[1] >= 8 else []
+
+    stats = []
+    for c in single_cols:
+        d = {}
+        for v, yy in zip(Xtr[:, c], ytr):
+            s, n = d.get(int(v), (0.0, 0)); d[int(v)] = (s + float(yy), n + 1)
+        stats.append(('s', c, d))
+    for c1, c2 in pair_cols:
+        d = {}
+        for v1, v2, yy in zip(Xtr[:, c1], Xtr[:, c2], ytr):
+            key = (int(v1), int(v2)); s, n = d.get(key, (0.0, 0)); d[key] = (s + float(yy), n + 1)
+        stats.append(('p', (c1, c2), d))
+
+    alpha = 20.0
+    for name, (X, y, u) in enc.items():
+        feats = [X.astype(np.float32)]
+        num = np.empty((len(X), 2 * len(stats)), dtype=np.float32)
+        j = 0
+        for typ, cols, d in stats:
+            if typ == 's':
+                vals = X[:, cols]
+                for i, v in enumerate(vals):
+                    s, n = d.get(int(v), (0.0, 0)); num[i, j] = np.log1p(n); num[i, j+1] = (s + alpha * gmean) / (n + alpha)
+            else:
+                c1, c2 = cols
+                for i, (v1, v2) in enumerate(zip(X[:, c1], X[:, c2])):
+                    s, n = d.get((int(v1), int(v2)), (0.0, 0)); num[i, j] = np.log1p(n); num[i, j+1] = (s + alpha * gmean) / (n + alpha)
+            j += 2
+        feats.append(num)
+        out[name] = (np.hstack(feats).astype(np.float32), y, u)
+    return out, cat_cols
+
+
+def fit_lgbm_lambdarank(enc, target, seed=0, use_cache=True):
+    os.makedirs('pred_cache', exist_ok=True)
+    Xtar, _, _ = enc[target]
+    path = os.path.join('pred_cache', f'026_lgbm_lambdarank_ctr_{target}_seed{seed}.npy')
+    if use_cache and os.path.isfile(path):
+        p = np.load(path)
+        if len(p) == len(Xtar): return p.astype(np.float64, copy=False)
+    t0 = time.time()
+    enc_lgb, cat_cols = add_ctr_features(enc)
+    Xtr, ytr, utr = enc_lgb['train']; Xva, yva, uva = enc_lgb['valid']
+    Xtr_s, ytr_s, gtr = group_sort(Xtr, ytr, utr)
+    Xva_s, yva_s, gva = group_sort(Xva, yva, uva)
+    model = lgb.LGBMRanker(
+        objective='lambdarank', metric='ndcg', boosting_type='gbdt',
+        n_estimators=700, learning_rate=0.035, num_leaves=63, max_depth=-1,
+        min_child_samples=80, subsample=0.85, subsample_freq=1,
+        colsample_bytree=0.9, reg_alpha=0.05, reg_lambda=1.0,
+        random_state=seed, n_jobs=4, label_gain=[0, 1],
+        lambdarank_truncation_level=5, verbosity=-1)
+    model.fit(Xtr_s, ytr_s, group=gtr, eval_set=[(Xva_s, yva_s)], eval_group=[gva], eval_at=[5],
+              categorical_feature=cat_cols, callbacks=[lgb.early_stopping(50, verbose=False)])
+    p = model.predict(enc_lgb[target][0], num_iteration=model.best_iteration_).astype(np.float64)
+    print(f"LightGBM LambdaRank best_iter={model.best_iteration_} trained in {time.time()-t0:.1f}s")
+    if use_cache: np.save(path, p)
+    return p
+
