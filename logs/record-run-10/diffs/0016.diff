+def append_score_feature(rawcat, enc, bpr, device='cpu'):
+    out = {}
+    for name, X0 in rawcat.items():
+        s = bpr.predict(enc[name][0], device=device).astype(np.float32)
+        # Standardize per split only for tree numerical stability; ranking uses order, not scale.
+        s = (s - s.mean()) / (s.std() + 1e-6)
+        out[name] = np.column_stack([X0, s])
+    return out
 
 
