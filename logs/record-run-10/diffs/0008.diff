+
+EXT_FIELDS = FIELDS + ['dow']
+
+
+def yyyymmdd_to_dow(d):
+    # Sakamoto algorithm, returns Monday=0 ... Sunday=6.
+    y = int(d) // 10000
+    m = (int(d) // 100) % 100
+    day = int(d) % 100
+    t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
+    if m < 3:
+        y -= 1
+    # Algorithm returns Sunday=0; convert to Monday=0.
+    return (y + y // 4 - y // 100 + y // 400 + t[m - 1] + day + 6) % 7
+
+
+def dur_bucket(ms):
+    try:
+        ms = int(ms)
+    except Exception:
+        ms = 0
+    # Match the starter-kit bucket boundaries used by 001.
+    if ms < 7_000:
+        return 0
+    if ms < 15_000:
+        return 1
+    if ms < 30_000:
+        return 2
+    if ms < 60_000:
+        return 3
+    return 4
+
+
+def row_features(row):
+    # (date, user_id, video_id, author_id, tab, duration_ms, label)
+    return (row[1], row[2], row[3], row[4], dur_bucket(row[5]), yyyymmdd_to_dow(row[0]))
+
+
+def encode_ext(splits):
+    vocabs = [{} for _ in EXT_FIELDS]
+    # Fit vocabularies on every split, as the starter encode does for id fields.
+    for rows in splits.values():
+        for r in rows:
+            vals = row_features(r)
+            for j, v in enumerate(vals):
+                if v not in vocabs[j]:
+                    vocabs[j][v] = len(vocabs[j])
+    offsets = np.cumsum([0] + [len(v) for v in vocabs[:-1]], dtype=np.int64)
+    dim = int(offsets[-1] + len(vocabs[-1]))
+    enc = {}
+    for name, rows in splits.items():
+        X = np.empty((len(rows), len(EXT_FIELDS)), dtype=np.int64)
+        y = np.empty(len(rows), dtype=np.float32)
+        users = np.empty(len(rows), dtype=object)
+        for i, r in enumerate(rows):
+            vals = row_features(r)
+            for j, v in enumerate(vals):
+                X[i, j] = vocabs[j][v] + offsets[j]
+            y[i] = float(r[6])
+            users[i] = r[1]
+        enc[name] = (X, y, users)
+    return enc, dim
 
 
