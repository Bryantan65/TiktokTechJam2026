+def multi_rank_blend(scores, weights, users, gamma=2.0):
+    users=np.asarray(users); out=np.zeros(len(users),dtype=np.float64); order=np.argsort(users,kind='mergesort'); s=0
+    while s<len(users):
+        e=s+1; u=users[order[s]]
+        while e<len(users) and users[order[e]]==u: e+=1
+        idx=order[s:e]; n=len(idx)
+        if n>1:
+            acc=np.zeros(n,dtype=np.float64)
+            denom=max(1,n-1)
+            for sc,w in zip(scores,weights):
+                r=np.empty(n,dtype=np.float64); r[np.argsort(sc[idx],kind='mergesort')]=np.arange(n,dtype=np.float64)/denom
+                acc += w * (r ** gamma)
+            out[idx]=acc
