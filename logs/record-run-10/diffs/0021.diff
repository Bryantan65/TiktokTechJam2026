+def hist_one(vals, counts, poss, ucnt, upos, recent):
+    u = vals[0]
+    uc = float(ucnt.get(u, 0)); up = float(upos.get(u, 0.0))
+    upr = (up + 2.0 * 0.36) / (uc + 2.0)
+    out = [np.log1p(uc), upr]
+    rq = recent.get(u)
+    out.append((sum(rq) + 2.0 * upr) / (len(rq) + 2.0) if rq else upr)
+    for j in HIST_FIELD_IDXS:
+        key = (u, j, vals[j])
+        c = float(counts.get(key, 0)); p = float(poss.get(key, 0.0))
+        out.append(np.log1p(c))
+        out.append((p + 5.0 * upr) / (c + 5.0))
+    return out
+
+
+def build_history_features(splits, hour_lookup):
+    counts = defaultdict(int); poss = defaultdict(float); ucnt = defaultdict(int); upos = defaultdict(float)
+    recent = defaultdict(lambda: deque(maxlen=20))
+    out = {}
+    for name, rows in splits.items():
+        feats = np.empty((len(rows), 3 + 2 * len(HIST_FIELD_IDXS)), dtype=np.float32)
+        update = (name == 'train')
+        for i, (r, h) in enumerate(zip(rows, hour_lookup[name])):
+            vals = row_features(r, h)
+            feats[i] = np.asarray(hist_one(vals, counts, poss, ucnt, upos, recent), dtype=np.float32)
+            if update:
+                y = float(r[6]); u = vals[0]
+                ucnt[u] += 1; upos[u] += y; recent[u].append(y)
+                for j in HIST_FIELD_IDXS:
+                    key = (u, j, vals[j]); counts[key] += 1; poss[key] += y
+        out[name] = feats
+    return out
+
