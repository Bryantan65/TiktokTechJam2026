+def append_target_enc(rawcat, cats, ytrain, alpha=20.0):
+    prior = float(np.mean(ytrain))
+    extras = {name: [] for name in rawcat}
+    for j in TE_FIELDS:
+        trc = cats['train'][:, j].astype(np.int64)
+        maxc = int(max([cats[name][:, j].max(initial=0) for name in cats])) + 1
+        cnt = np.bincount(trc, minlength=maxc).astype(np.float32)
+        sm = np.bincount(trc, weights=ytrain.astype(np.float32), minlength=maxc).astype(np.float32)
+        for name in rawcat:
+            c = cats[name][:, j].astype(np.int64)
+            cc = cnt[c]; ss = sm[c]
+            if name == 'train':
+                yy = ytrain.astype(np.float32)
+                den = np.maximum(cc - 1.0, 0.0) + alpha
+                te = (ss - yy + alpha * prior) / den
+                cf = np.log1p(np.maximum(cc - 1.0, 0.0))
+            else:
+                te = (ss + alpha * prior) / (cc + alpha)
+                cf = np.log1p(cc)
+            extras[name].append(te.astype(np.float32)); extras[name].append(cf.astype(np.float32))
+    out = {}
+    for name in rawcat:
+        out[name] = np.column_stack([rawcat[name]] + extras[name]).astype(np.float32)
+    return out
+
