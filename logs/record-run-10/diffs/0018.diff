+def key_at(C, i, spec):
+    if len(spec) == 1:
+        return int(C[i, spec[0]])
+    return tuple(int(C[i, j]) for j in spec)
+
+
+def append_target_stats(base_rawcat, codes, enc):
+    ytr = enc['train'][1]
+    Ctr = codes['train']
+    gmean = float(ytr.mean()) if len(ytr) else 0.0
+    # field indices: user, video, author, tab, dur, dow, hour, tod4
+    specs = [
+        (1,), (2,), (3,), (4,), (5,), (6,), (7,),
+        (0, 1), (0, 2), (0, 3), (0, 4), (0, 6),
+        (2, 3), (2, 4), (3, 6), (3, 7),
+    ]
+    stat_blocks = {name: [] for name in codes}
+    for spec in specs:
+        cnt = {}
+        sm = {}
+        for i in range(len(Ctr)):
+            k = key_at(Ctr, i, spec)
+            cnt[k] = cnt.get(k, 0) + 1
+            sm[k] = sm.get(k, 0.0) + float(ytr[i])
+        prior = 5.0 if 0 in spec else 20.0
+        for name, C in codes.items():
+            y = enc[name][1]
+            mean_feat = np.empty(len(C), dtype=np.float32)
+            cnt_feat = np.empty(len(C), dtype=np.float32)
+            loo = (name == 'train')
+            for i in range(len(C)):
+                k = key_at(C, i, spec)
+                c = cnt.get(k, 0)
+                s = sm.get(k, 0.0)
+                if loo and c > 0:
+                    c2 = c - 1
+                    s2 = s - float(y[i])
+                else:
+                    c2 = c
+                    s2 = s
+                if c2 > 0:
+                    mean_feat[i] = (s2 + prior * gmean) / (c2 + prior)
+                else:
+                    mean_feat[i] = gmean
+                cnt_feat[i] = np.log1p(float(c2))
+            stat_blocks[name].append(mean_feat)
+            stat_blocks[name].append(cnt_feat)
+    out = {}
+    for name in base_rawcat:
+        out[name] = np.column_stack([base_rawcat[name]] + stat_blocks[name]).astype(np.float32)
+    return out
+
