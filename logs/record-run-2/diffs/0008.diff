+def _as_int(x, default=0):
+    try:
+        return int(float(x))
+    except Exception:
+        return default
+
+
+def _get(row, names, default='0'):
+    for n in names:
+        if n in row and row[n] != '':
+            return row[n]
+    return default
+
+
+def date_to_dow(date_int):
+    try:
+        s = str(int(date_int))
+        return _dt.date(int(s[:4]), int(s[4:6]), int(s[6:8])).weekday()
+    except Exception:
+        return 0
+
+
+def dur_bucket(duration_ms):
+    # Same coarse duration context as starter-kit FM uses; only for raw-row
+    # alignment fallback diagnostics, not appended as a new feature.
+    d = _as_int(duration_ms)
+    return min(d // 10000, 30)
+
+
+def raw_key_from_csv(row):
+    return (_as_int(_get(row, ['date'])),
+            _as_int(_get(row, ['user_id', 'userId', 'user'])),
+            _as_int(_get(row, ['video_id', 'videoId', 'photo_id', 'item_id'])),
+            _as_int(_get(row, ['author_id', 'authorId'])),
+            _as_int(_get(row, ['tab'])),
+            _as_int(_get(row, ['duration_ms', 'duration', 'video_duration'])))
+
+
+def key_from_tuple(r):
+    return (_as_int(r[0]), _as_int(r[1]), _as_int(r[2]), _as_int(r[3]),
+            _as_int(r[4]), _as_int(r[5]))
+
+
+def read_hour_lookup(data_dir):
+    files = [
+        'log_standard_4_08_to_4_21_pure.csv',
+        'log_standard_4_22_to_5_08_pure.csv',
+    ]
+    q = defaultdict(deque)
+    nread = 0
+    for fn in files:
+        path = os.path.join(data_dir, fn)
+        if not os.path.exists(path):
+            continue
+        with open(path, 'r', encoding='utf-8', newline='') as f:
+            rdr = csv.DictReader(f)
+            for row in rdr:
+                hm = _as_int(_get(row, ['hourmin', 'hour_min', 'time', 'timestamp']), -1)
+                if hm >= 0:
+                    hour = max(0, min(23, hm // 100))
+                else:
+                    hour = 0
+                q[raw_key_from_csv(row)].append(hour)
+                nread += 1
+    return q, nread
+
+
+def append_time_features(splits, enc, dim, data_dir, verbose=True):
+    hour_lookup, nread = read_hour_lookup(data_dir)
+    if verbose:
+        print(f"read raw hour rows={nread:,d}; appending dow/hour fields")
+
+    # Reserve compact categorical IDs after the starter-kit feature space.
+    # hour: 24 categories, dow: 7 categories. Unknown/missing hour maps to 0.
+    hour_offset = dim
+    dow_offset = dim + 24
+    new_enc = {}
+    matched = 0
+    total = 0
+    for sp, rows in splits.items():
+        X, y, users = enc[sp]
+        extra = np.zeros((len(rows), 2), dtype=np.int64)
+        for i, r in enumerate(rows):
+            k = key_from_tuple(r)
+            if hour_lookup and hour_lookup.get(k):
+                h = hour_lookup[k].popleft()
+                matched += 1
+            else:
+                h = 0
+            d = date_to_dow(r[0])
+            extra[i, 0] = hour_offset + h
+            extra[i, 1] = dow_offset + d
+        total += len(rows)
+        new_enc[sp] = (np.concatenate([X.astype(np.int64), extra], axis=1), y, users)
+    if verbose:
+        print(f"hour matched {matched:,d}/{total:,d}; new dim={dim + 31}; fields={FIELDS}+['hour','dow']")
+    return new_enc, dim + 31
 
 
