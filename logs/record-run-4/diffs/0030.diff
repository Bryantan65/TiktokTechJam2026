+def target_frequency_adjust(rows):
+    """Unlabelled transductive exposure-frequency signal inside the requested split."""
+    uv=defaultdict(int); ua=defaultdict(int); uat=defaultdict(int)
+    for r in rows:
+        u=_to_int(r[1]); v=_to_int(r[2]); a=_to_int(r[3]); t=_to_int(r[4])
+        uv[(u,v)] += 1; ua[(u,a)] += 1; uat[(u,a,t)] += 1
+    out=np.zeros(len(rows),dtype=np.float32)
+    for i,r in enumerate(rows):
+        u=_to_int(r[1]); v=_to_int(r[2]); a=_to_int(r[3]); t=_to_int(r[4])
+        # tiny monotone boosts: production repeatedly exposing a target/author to a user is weak evidence of relevance.
+        adj = 0.050*np.log1p(max(0, uv[(u,v)]-1)) + 0.012*np.log1p(max(0, ua[(u,a)]-1)) + 0.010*np.log1p(max(0, uat[(u,a,t)]-1))
+        out[i]=np.float32(min(adj,0.10))
+    return out
+
