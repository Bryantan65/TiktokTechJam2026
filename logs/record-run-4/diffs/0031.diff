+def build_user_trends(train_rows, decay=0.98):
+    gp=0.; gc=0.; up=defaultdict(float); uc=defaultdict(float); rp=defaultdict(float); rc=defaultdict(float); last={}; t_user=defaultdict(int); final_t=defaultdict(int)
+    for r in train_rows:
+        u=_to_int(r[1]); lab=float(_to_int(r[6])); gp+=lab; gc+=1.; up[u]+=lab; uc[u]+=1.; t_user[u]+=1; t=t_user[u]; final_t[u]=t
+        if u in last:
+            fac=decay**(t-last[u]); rp[u]*=fac; rc[u]*=fac
+        rp[u]+=lab; rc[u]+=1.; last[u]=t
+    g=gp/max(gc,1.); trend={}
+    for u,c in uc.items():
+        if c < 8: continue
+        if u in last:
+            fac=decay**(final_t[u]-last[u]); rp[u]*=fac; rc[u]*=fac
+        overall=(up[u]+8.*g)/(c+8.); recent=(rp[u]+6.*overall)/(rc[u]+6.)
+        trend[u]=float(np.clip(_logit(recent)-_logit(overall), -2.0, 2.0))
+    return trend
+
+def trend_position_adjust(rows, trend, weight=0.06):
+    byu=defaultdict(list)
+    for i,r in enumerate(rows): byu[_to_int(r[1])].append(i)
+    out=np.zeros(len(rows),dtype=np.float32)
+    for u,idxs in byu.items():
+        tr=trend.get(u,0.0); n=len(idxs)
+        if n <= 1 or tr == 0.0: continue
+        denom=max(n-1,1)
+        for j,i in enumerate(idxs):
+            pos=j/denom - 0.5
+            out[i]=np.float32(np.clip(weight*tr*pos, -0.08, 0.08))
+    return out
+
