+class Ensemble:
+    def __init__(self, models):
+        self.models = models
+
+    def predict(self, X, device='cpu'):
+        preds = None
+        for m in self.models:
+            p = m.predict(X, device=device).astype(np.float64)
+            preds = p if preds is None else preds + p
+        return preds / float(len(self.models))
+
+
+def run(splits, data_dir, k=16, lr=0.001, epochs=40, seed=0, device='cpu', verbose=True):
+    enc, aux, matched, dim = encode_with_time_aux(splits, data_dir)
+    # Two members keeps runtime reasonable while still averaging independent FM factors and samplers.
+    member_seeds = [int(seed), int(seed) + 1009]
+    models = []
+    for s in member_seeds:
+        torch.manual_seed(s)
+        models.append(train_one(enc, aux, matched, dim, k=k, lr=lr, epochs=epochs,
+                                seed=s, device=device, verbose=verbose))
+    return Ensemble(models), enc
 
 
