+def _clip01(x):
+    return min(max(float(x), 1e-4), 1.0 - 1e-4)
+
+
+def _logit(p):
+    p = _clip01(p)
+    return np.log(p / (1.0 - p))
+
+
+def build_history_stats(train_rows):
+    """Train-only user-conditioned counts for conservative post-fit affinities."""
+    up = defaultdict(float); uc = defaultdict(float)
+    uap = defaultdict(float); uac = defaultdict(float)
+    uvp = defaultdict(float); uvc = defaultdict(float)
+    utp = defaultdict(float); utc = defaultdict(float)
+    gp = 0.0; gc = 0.0
+    for r in train_rows:
+        user = _to_int(r[1]); video = _to_int(r[2]); author = _to_int(r[3])
+        tab = _to_int(r[4]); lab = float(_to_int(r[6]))
+        gp += lab; gc += 1.0
+        up[user] += lab; uc[user] += 1.0
+        ka = (user, author); kv = (user, video); kt = (user, tab)
+        uap[ka] += lab; uac[ka] += 1.0
+        uvp[kv] += lab; uvc[kv] += 1.0
+        utp[kt] += lab; utc[kt] += 1.0
+    global_rate = gp / max(gc, 1.0)
+    return {
+        'global': global_rate,
+        'up': up, 'uc': uc,
+        'uap': uap, 'uac': uac,
+        'uvp': uvp, 'uvc': uvc,
+        'utp': utp, 'utc': utc,
+    }
+
+
+def history_adjust(rows, stats):
+    """Small logit adjustments from user-author/video/tab historical rates.
+
+    Smoothing to the user's own train rate prevents global activity bias from
+    acting as a user-side constant, while confidence keeps one-off histories
+    from dominating the FM logits.
+    """
+    g = stats['global']
+    out = np.zeros(len(rows), dtype=np.float32)
+    for i, r in enumerate(rows):
+        user = _to_int(r[1]); video = _to_int(r[2]); author = _to_int(r[3]); tab = _to_int(r[4])
+        uc = stats['uc'].get(user, 0.0)
+        ur = (stats['up'].get(user, 0.0) + 8.0 * g) / (uc + 8.0)
+        base = _logit(ur)
+        adj = 0.0
+
+        # Same author by the same user: relatively common and should affect ranking.
+        ka = (user, author)
+        ca = stats['uac'].get(ka, 0.0)
+        if ca > 0.0:
+            ra = (stats['uap'].get(ka, 0.0) + 2.5 * ur) / (ca + 2.5)
+            conf = np.sqrt(ca / (ca + 4.0))
+            adj += 0.45 * conf * (_logit(ra) - base)
+
+        # Exact repeated video is rarer; use it, but downweight so duplicates do not overfit.
+        kv = (user, video)
+        cv = stats['uvc'].get(kv, 0.0)
+        if cv > 0.0:
+            rv = (stats['uvp'].get(kv, 0.0) + 1.5 * ur) / (cv + 1.5)
+            conf = np.sqrt(cv / (cv + 3.0))
+            adj += 0.30 * conf * (_logit(rv) - base)
+
+        # User-tab preference is a low-variance sequential/context statistic beyond tab main effect.
+        kt = (user, tab)
+        ct = stats['utc'].get(kt, 0.0)
+        if ct > 0.0:
+            rt = (stats['utp'].get(kt, 0.0) + 4.0 * ur) / (ct + 4.0)
+            conf = np.sqrt(ct / (ct + 8.0))
+            adj += 0.20 * conf * (_logit(rt) - base)
+
+        out[i] = np.float32(np.clip(adj, -1.0, 1.0))
+    return out
+
