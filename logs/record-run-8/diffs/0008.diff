+def build_hard_pools(groups, scores, topn=20):
+    pools = []
+    for _, n in groups:
+        if len(n) <= topn:
+            pools.append(n)
+        else:
+            sc = scores[n]
+            # argpartition is O(n); sort only the selected top tail for stable sampling.
+            idx = np.argpartition(sc, -topn)[-topn:]
+            idx = idx[np.argsort(sc[idx])[::-1]]
+            pools.append(n[idx])
+    return pools
