+def add_cross_fields(splits, enc, base_dim):
+    """Append [user,video], [user,author], [user,tab] categorical columns."""
+    cross_specs = [
+        ('uv', lambda r: (r[1], r[2])),
+        ('ua', lambda r: (r[1], r[3])),
+        ('ut', lambda r: (r[1], r[4])),
+    ]
+    maps = []
+    offset = int(base_dim)
+    for name, fn in cross_specs:
+        vals = []
+        for sp in splits:
+            vals.extend(fn(r) for r in splits[sp])
+        uniq = {v: i + offset for i, v in enumerate(sorted(set(vals), key=str))}
+        maps.append((fn, uniq, offset))
+        offset += len(uniq)
+
+    out = {}
+    for sp, rows in splits.items():
+        X, y, users = enc[sp]
+        cols = []
+        for fn, mp, _ in maps:
+            cols.append(np.asarray([mp[fn(r)] for r in rows], dtype=np.int64))
+        X2 = np.concatenate([X.astype(np.int64)] + [c[:, None] for c in cols], axis=1)
+        out[sp] = (X2, y, users)
+    return out, offset
 
 
