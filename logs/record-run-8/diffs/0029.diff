+        vals=[]; ks=aux_keys_for(r)
+        for k in names:
+            c=cnts[k].get(ks[k],0); s=sums[k].get(ks[k],None)
+            if s is None: s=np.zeros(naux,np.float64)
+            if loo:
+                c=max(0,c-1); s=np.maximum(0.0,s-cur)
+            sm=(s+8.0*glob)/(c+8.0)
+            vals.append(np.log1p(c)); vals.extend(sm.tolist())
