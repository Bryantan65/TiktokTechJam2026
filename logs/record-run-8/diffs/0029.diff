+def aux_stat_maps(rows,raw):
+    names=['av','aa','at','uav','uaa','uat','uad']; naux=6
+    glob=np.zeros(naux,np.float64); cnt=0
+    sums={k:defaultdict(lambda: np.zeros(naux,np.float64)) for k in names}; cnts={k:defaultdict(int) for k in names}
+    for i,r in enumerate(rows):
+        v=raw[i][2].astype(np.float64) if i<len(raw) else np.zeros(naux,np.float64)
+        glob += v; cnt += 1; ks=aux_keys_for(r)
+        for k in names:
+            sums[k][ks[k]] += v; cnts[k][ks[k]] += 1
+    glob=glob/max(1,cnt)
+    return glob,sums,cnts
+
+def aux_stat_feats(rows,raw,pack,loo=False):
+    glob,sums,cnts=pack; names=['av','aa','at','uav','uaa','uat','uad']; naux=6
+    X=np.zeros((len(rows),len(names)*(1+naux)),np.float32)
+    for i,r in enumerate(rows):
