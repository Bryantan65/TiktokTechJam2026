+def parse_hour_bucket(v):
+    try:
+        x = int(float(v))
+        if x > 10000: x = (x // 10000) % 24
+        elif x >= 100: x = (x // 100) % 24
+        else: x = x % 24
+        return max(0, min(5, x // 4))
+    except Exception:
+        return 6
+
+def day_of_week(date_int):
+    try:
+        return datetime.strptime(str(int(date_int)), '%Y%m%d').weekday()
+    except Exception:
+        return 7
+
+def load_hour_buckets(data_dir, splits, verbose=False):
+    paths = find_log_files(data_dir)
+    out = {k: np.full(len(v), 6, dtype=np.int64) for k, v in splits.items()}
+    if paths is None:
+        if verbose: print('time features: raw log csvs not found; using unknown hour')
+        return out
+    full_q, short_q = defaultdict(deque), defaultdict(deque)
+    for path in paths:
+        with open(path, 'r', newline='', encoding='utf-8') as f:
+            for row in csv.DictReader(f):
+                hb = parse_hour_bucket(row_get(row, ['hourmin','hour_min','hour','time','timestamp'], ''))
+                full, short = make_keys_from_csv(row)
+                if full is not None: full_q[full].append(hb)
+                short_q[short].append(hb)
+    total_miss = 0; total = 0
+    for sp, rows in splits.items():
+        miss = 0
+        for i, r in enumerate(rows):
+            hb = None; fq = full_q.get(make_key_from_tuple(r, True))
+            if fq: hb = fq.popleft()
+            else:
+                sq = short_q.get(make_key_from_tuple(r, False))
+                if sq: hb = sq.popleft()
+            if hb is None: miss += 1; hb = 6
+            out[sp][i] = hb
+        total_miss += miss; total += len(rows)
+        if verbose: print(f'time join {sp}: missing {miss}/{len(rows)}')
+    if verbose: print(f'time join total missing {total_miss}/{total}')
+    return out
+
