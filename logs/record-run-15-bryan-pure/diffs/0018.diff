+def dur_bucket(ms):
+    try: x = float(ms)
+    except Exception: x = 0.0
+    if x < 5000: return 0
+    if x < 10000: return 1
+    if x < 20000: return 2
+    if x < 30000: return 3
+    if x < 60000: return 4
+    if x < 120000: return 5
+    return 6
+
+def encode_with_time(splits, hour_buckets):
+    # Fit transductive id maps, as the starter-kit encoder does for the base fields.
+    fields = ['user','video','author','tab','dur','hour4','dow']
+    maps = [dict() for _ in fields]; offsets = []; off = 0
+    vals_by_split = {}
+    for sp, rows in splits.items():
+        vals = []
+        hb = hour_buckets.get(sp, np.full(len(rows), 6, dtype=np.int64))
+        for i, r in enumerate(rows):
+            vals.append((str(r[1]), str(r[2]), str(r[3]), str(r[4]), str(dur_bucket(r[5])), str(int(hb[i])), str(day_of_week(r[0]))))
+        vals_by_split[sp] = vals
+        for vrow in vals:
+            for j, v in enumerate(vrow):
+                if v not in maps[j]: maps[j][v] = len(maps[j])
+    for m in maps:
+        offsets.append(off); off += len(m)
+    enc = {}
+    for sp, vals in vals_by_split.items():
+        X = np.zeros((len(vals), len(fields)), dtype=np.int64)
+        for i, vrow in enumerate(vals):
+            for j, v in enumerate(vrow): X[i, j] = offsets[j] + maps[j][v]
+        y = np.asarray([r[6] for r in splits[sp]], dtype=np.float32)
+        users = np.asarray([r[1] for r in splits[sp]], dtype=object)
+        enc[sp] = (X, y, users)
+    return enc, off
+
