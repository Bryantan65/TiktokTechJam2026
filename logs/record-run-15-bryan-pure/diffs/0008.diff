+def reciprocal_rank_fusion(member_preds, groups, k_rrf=60.0):
+    n = len(member_preds[0])
+    fused = np.zeros(n, dtype=np.float64)
+    for p in member_preds:
+        p = np.asarray(p)
+        for idx in groups:
+            vals = p[idx]
+            order = np.argsort(-vals, kind='mergesort')
+            ranks = np.empty(len(idx), dtype=np.float64)
+            ranks[order] = np.arange(1, len(idx) + 1, dtype=np.float64)
+            fused[idx] += 1.0 / (k_rrf + ranks)
+    return fused / float(len(member_preds))
+
