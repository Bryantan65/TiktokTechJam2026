+    pos_by_u = defaultdict(list)
+    neg_by_u = defaultdict(list)
+    for i, (yy, uu) in enumerate(zip(y, users)):
+        # users may be strings/objects; dict keys are fine.
+        if yy > 0.5:
+            pos_by_u[uu].append(i)
+        else:
+            neg_by_u[uu].append(i)
