+def z_by_user(scores, users):
+    scores = np.asarray(scores, dtype=np.float64)
+    out = np.zeros_like(scores)
+    groups = defaultdict(list)
+    for i, u in enumerate(users):
+        groups[u].append(i)
+    for idx in groups.values():
+        v = scores[idx]
+        sd = v.std()
+        out[idx] = (v - v.mean()) / sd if sd > 1e-8 else (v - v.mean())
+    return out
+
+
+def member_pred(name, enc, dim, target, seed, mode, split_name, device):
+    os.makedirs('pred_cache', exist_ok=True)
+    path = os.path.join('pred_cache', f'010_{name}_{split_name}_seed{seed}.npy')
+    if os.path.isfile(path):
+        return np.load(path)
+    model = train_model(enc, dim, seed=seed, mode=mode, device=device)
+    X, _, _ = enc[target]
+    p = model.predict(X, device=device).astype(np.float64)
+    np.save(path, p)
+    return p
 
 
