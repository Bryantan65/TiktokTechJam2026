+class Stat:
+    __slots__=('n','s')
+    def __init__(self): self.n=0; self.s=0.0
+    def mean(self,prior=0.35,k=20.0): return (self.s+k*prior)/(self.n+k)
+    def add(self,y): self.n+=1; self.s+=float(y)
+
+def build_lgb_features(splits,target):
+    allrows=[]
+    for sp in splits:
+        for r in splits[sp]: allrows.append(r)
+    maps=[]
+    for j in [0,1,2,3,4]:
+        mp={}
+        for r in allrows:
+            v=_s(r[j])
+            if v not in mp: mp[v]=len(mp)
+        maps.append(mp)
+    ytrain=np.asarray([r[6] for r in splits['train']],dtype=np.float32); prior=float(ytrain.mean()) if len(ytrain) else 0.35
+    stats=defaultdict(Stat); day_count=defaultdict(int); global_i=0; total=max(1,sum(len(v) for v in splits.values()))
+    def feats_for(r,update=False):
+        nonlocal global_i
+        date,u,v,a,tab,dur=[_s(r[i]) for i in range(6)]; y=float(r[6]); dow=date_to_dow(date); db=day_count[date]
+        keys=[('v',v),('a',a),('tab',tab),('uv',u,v),('ua',u,a),('utab',u,tab),('udur',u,dur),('u',u),('av',a,v)]
+        num=[]
+        for key in keys:
+            st=stats[key]; num.extend([np.log1p(st.n),st.mean(prior,20.0)])
+        num.extend([float(dow),float(db%5000)/5000.0,float(global_i)/float(total),np.log1p(float(dur) if dur.replace('.','',1).isdigit() else 0.0)])
+        cat=[maps[0].get(date,-1),maps[1].get(u,-1),maps[2].get(v,-1),maps[3].get(a,-1),maps[4].get(tab,-1),dow]
+        if update:
+            for key in keys: stats[key].add(y)
+            day_count[date]+=1; global_i+=1
+        return cat+num
+    Xtr=[]
+    for r in splits['train']: Xtr.append(feats_for(r,True))
+    Xtg=[]
+    for r in splits[target]: Xtg.append(feats_for(r,False))
