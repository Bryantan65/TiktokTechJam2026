+def make_groups(sorted_users, max_group=10000):
+    users = np.asarray(sorted_users)
+    if len(users) == 0:
+        return []
+    cuts = np.flatnonzero(users[1:] != users[:-1]) + 1
+    starts = np.r_[0, cuts]
+    ends = np.r_[cuts, len(users)]
+    groups = []
+    for s, e in zip(starts, ends):
+        n = int(e - s)
+        while n > max_group:
+            groups.append(max_group)
+            n -= max_group
+        if n > 0:
+            groups.append(n)
+    return groups
+
