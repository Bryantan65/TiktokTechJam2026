+def per_user_z_fuse(member_preds, users):
+    P = np.vstack([p.astype(np.float32, copy=False) for p in member_preds])
+    users = np.asarray(users)
+    out = np.zeros(P.shape[1], dtype=np.float32)
+    order = np.argsort(users, kind='mergesort')
+    us = users[order]
+    starts = np.r_[0, np.flatnonzero(us[1:] != us[:-1]) + 1, len(us)]
+    for a, b in zip(starts[:-1], starts[1:]):
+        idx = order[a:b]
+        block = P[:, idx]
+        mu = block.mean(axis=1, keepdims=True)
+        sd = block.std(axis=1, keepdims=True)
+        z = (block - mu) / np.maximum(sd, 1e-6)
+        out[idx] = z.mean(axis=0)
+    return out.astype(np.float64)
+
