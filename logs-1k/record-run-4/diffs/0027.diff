+def push_window(dq, cv, ca, ct, row, y):
+    v=int(row[1]); a=int(row[2]); t=int(row[3])
+    dq.append((v,a,t,int(y)))
+    cv[v]+=1; ca[a]+=1; ct[t]+=1
