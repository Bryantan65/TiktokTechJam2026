+def factorize_pair(a, b):
+    """Dense non-negative codes for a pair of integer arrays with same shape."""
+    a = a.astype(np.int64, copy=False)
+    b = b.astype(np.int64, copy=False)
+    # unique rows on an (N,2) array is robust and avoids overflow-prone products
+    pairs = np.empty((len(a), 2), dtype=np.int64)
+    pairs[:, 0] = a
+    pairs[:, 1] = b
+    _, inv = np.unique(pairs, axis=0, return_inverse=True)
+    return inv.astype(np.int32, copy=False)
+
