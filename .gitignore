# Datasets — downloaded separately, never committed (KuaiRand-Pure alone is ~195MB)
rec_datasets/*
!rec_datasets/.gitkeep

# Agent run logs — tracked as deliverables (run-log requirements:
# hypothesis, diff, metrics, error/recovery). Each run auto-creates
# its own folder under logs/ (e.g. logs/record-run-3/).
checkpoints/
*.pt
*.pth

# Prediction cache — per-member predictions saved by ensemble solutions
pred_cache/

# Prediction arrays belong in pred_cache/. A solution run by hand with
# --out _029.npy drops an 80MB byproduct in the repo root instead.
*.npy

# 1k test is 4.1M rows -> 118MB, over GitHub's 100MB per-file limit.
# The 1k predictions are 123 MB raw - past GitHub's 100 MB hard block - so the
# gzip is committed instead and the plain CSV stays ignored. Deliverable 4 asks
# for the bonus benchmark's output, so it has to be in the repo somewhere;
# `gzip -dc submission_1k.csv.gz > submission_1k.csv` restores it byte-identical.
# Regenerate from scratch with the commands in docs/results.md.
submission_1k.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Secrets
.env
.env.bak*

# Local
firebase-debug.log

# Pre-release competition material — Early Bird access, not for public release
techjaminfo*.docx
*.docx

# Local backups
*.bak

# Trained models: weights are large and reproducible, so ignored.
# The small score files (models/*.json, models/*_result.csv) ARE tracked on
# purpose — they are the evidence behind every number in RESULTS.md.
models/*.pt


bash.exe.stackdump
# Per-member prediction cache written by solutions; regenerable, never committed.
pred_cache/

# Parsed-data cache (harness/data.py). Regenerated on demand; never a source of truth.
.cache/
