# Datasets — downloaded separately, never committed (KuaiRand-Pure alone is ~195MB)
rec_datasets/*
!rec_datasets/.gitkeep

# Agent run outputs. logs/iterations/*.json is a REQUIRED DELIVERABLE
# (run-log requirements: hypothesis, diff, metrics, error/recovery), so it is
# tracked. ~1-3KB per iteration.
#
# logs/events.jsonl is tracked for the same reason: it is the chronological
# run log, and the only place a failure *between* experiments (an API 500, a
# retry, a crash) is recorded. Robustness is scored on how failures were
# handled, so this file is the evidence. One line per event, a few KB per run.
logs/*
!logs/iterations/
!logs/events.jsonl
logs/iterations/*
!logs/iterations/*.json
checkpoints/
*.pt
*.pth

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Secrets
.env

# Local
firebase-debug.log

# Pre-release competition material — Early Bird access, not for public release
techjaminfo*.docx
*.docx

# Local backups
*.bak

# Trained models: weights are large and reproducible, so ignored.
# The small score files (models/*.json, models/*_result.csv) ARE tracked on
# purpose — they are the evidence behind every number in RESULTS.md.
models/*.pt


bash.exe.stackdump