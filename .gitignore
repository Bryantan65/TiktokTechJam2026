# Datasets — downloaded separately, never committed (KuaiRand-Pure alone is ~195MB)
rec_datasets/*
!rec_datasets/.gitkeep

# Agent run logs — tracked as deliverables (run-log requirements:
# hypothesis, diff, metrics, error/recovery). Each run auto-creates
# its own folder under logs/ (e.g. logs/record-run-3/).
checkpoints/
*.pt
*.pth

# Prediction cache — per-member predictions saved by ensemble solutions
pred_cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Secrets
.env

# Local
firebase-debug.log

# Pre-release competition material — Early Bird access, not for public release
techjaminfo*.docx
*.docx

# Local backups
*.bak

# Trained models: weights are large and reproducible, so ignored.
# The small score files (models/*.json, models/*_result.csv) ARE tracked on
# purpose — they are the evidence behind every number in RESULTS.md.
models/*.pt


bash.exe.stackdump
# Per-member prediction cache written by solutions; regenerable, never committed.
pred_cache/
