# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
#   cp .env.example .env

# Required.
OPENAI_API_KEY=sk-your-key-here

# Which model the agent runs on. Optional; defaults to gpt-4o, which is old.
# Find valid ids for your account:
#   python -c "from openai import OpenAI; [print(m.id) for m in OpenAI().models.list()]"
AGENT_MODEL=gpt-5.5

# The gpt-5.6 family (sol/terra/luna) will not accept function tools on
# /v1/chat/completions unless reasoning is switched off. To use them:
#   AGENT_MODEL=gpt-5.6-sol
#   AGENT_REASONING_EFFORT=none
# Leave AGENT_REASONING_EFFORT unset for gpt-5.5 and earlier, which take tools
# natively and keep reasoning on.
#
#   gpt-5.6-sol    $4 / $20   newer, cheaper, but reasoning off via this API
#   gpt-5.6-terra  $2 / $12   cheapest of the three, same constraint
#   gpt-5.5        $5 / $30   reasoning on, works unmodified
#AGENT_REASONING_EFFORT=none

# Price per 1M tokens, used only to report cost. Optional, but the defaults
# below are gpt-4o's and will be wrong for any other model — and total token
# spend is a reported submission deliverable, so a wrong price misreports it.
# Current prices: https://openai.com/api/pricing/
AGENT_INPUT_COST_PER_M=2.50
AGENT_OUTPUT_COST_PER_M=10.00

# Hard stops for an unattended run. --max-iter counts agent loop passes, but
# one pass can run many experiments: the first real run did 9 experiments and
# $3.34 inside a single "iteration". These bound it.
AGENT_MAX_EXPERIMENTS=50   # organiser hard cap
AGENT_MAX_COST_USD=0   # 0 = no cap (default). Tokens are reported, not capped.

# Price per 1M cached input tokens. The loop resends the conversation on every
# tool round, so most input is a cache hit and billing it at the full input
# price overstates the reported spend. Defaults to a tenth of input.
AGENT_CACHED_COST_PER_M=0.50

# How many completed iterations of chat history to carry forward. The ledger is
# the durable memory and every iteration's message is rebuilt from it, so older
# turns are duplicates resent on every round. 1 keeps continuity cheaply; 0 makes
# each iteration fully independent (cheapest); higher costs more each round.
AGENT_HISTORY_ITERATIONS=1

# Organiser wall-clock ceiling, 6 h per run. The loop stops early enough to
# finish the experiment in flight without crossing it.
AGENT_MAX_WALL_SECONDS=21600
