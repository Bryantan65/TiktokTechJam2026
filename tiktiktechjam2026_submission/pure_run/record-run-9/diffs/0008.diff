+def pos_bucket(c):
+    if c <= 0:
+        return 0
+    if c == 1:
+        return 1
+    if c == 2:
+        return 2
+    if c <= 5:
+        return 3
+    return 4
+
+
+def neg_bucket(c):
+    if c <= 0:
+        return 0
+    if c <= 2:
+        return 1
+    if c <= 5:
+        return 2
+    if c <= 10:
+        return 3
+    return 4
+
+
+def ratio_bucket(p, n):
+    t = p + n
+    if t <= 0:
+        return 0
+    r = p / t
+    if r < 0.20:
+        return 1
+    if r < 0.40:
+        return 2
+    if r < 0.60:
+        return 3
+    if r < 0.80:
+        return 4
+    return 5
+
+
+def build_history_raw_features(splits):
+    """Return raw categorical feature rows per split plus labels/users.
+
+    Tuple columns are (date,user,video,author,tab,duration_ms,label).  We include
+    baseline fields and six history fields: user-video pos/neg buckets,
+    user-author pos/neg buckets, and user-author/user-video positive-rate buckets.
+    """
+    # Build train features online from prior train rows only.
+    up_v = defaultdict(int); un_v = defaultdict(int)
+    up_a = defaultdict(int); un_a = defaultdict(int)
+    raw = {}
+    labels = {}
+    users = {}
+
+    def row_feats(row, update=False):
+        date, u, v, a, tab, dur, y = row
+        dur_bucket = int(dur) // 10000
+        kv = (u, v); ka = (u, a)
+        pv, nv = up_v[kv], un_v[kv]
+        pa, na = up_a[ka], un_a[ka]
+        feats = [u, v, a, tab, dur_bucket,
+                 pos_bucket(pv), neg_bucket(nv),
+                 pos_bucket(pa), neg_bucket(na),
+                 ratio_bucket(pa, na), ratio_bucket(pv, nv)]
+        if update:
+            if y > 0.5:
+                up_v[kv] += 1; up_a[ka] += 1
+            else:
+                un_v[kv] += 1; un_a[ka] += 1
+        return feats
+
+    tr_feats = []
+    tr_labels = []
+    tr_users = []
+    for row in splits['train']:
+        tr_feats.append(row_feats(row, update=True))
+        tr_labels.append(row[6]); tr_users.append(row[1])
+    raw['train'] = tr_feats
+    labels['train'] = np.asarray(tr_labels, dtype=np.float32)
+    users['train'] = np.asarray(tr_users, dtype=np.int64)
+
+    # Frozen train history for validation/test: do not update on their labels.
+    for sp in ('valid', 'test'):
+        feats = []
+        ys = []
+        us = []
+        for row in splits[sp]:
+            feats.append(row_feats(row, update=False))
+            ys.append(row[6]); us.append(row[1])
+        raw[sp] = feats
+        labels[sp] = np.asarray(ys, dtype=np.float32)
+        users[sp] = np.asarray(us, dtype=np.int64)
+    return raw, labels, users
+
+
+def encode_history(splits):
+    raw, labels, users = build_history_raw_features(splits)
+    n_fields = len(raw['train'][0])
+    maps = []
+    offset = 0
+    for j in range(n_fields):
+        vals = set()
+        for sp in ('train', 'valid', 'test'):
+            vals.update(r[j] for r in raw[sp])
+        mp = {v: offset + i for i, v in enumerate(sorted(vals))}
+        maps.append(mp)
+        offset += len(mp)
+    enc = {}
+    for sp in ('train', 'valid', 'test'):
+        X = np.empty((len(raw[sp]), n_fields), dtype=np.int64)
+        for i, r in enumerate(raw[sp]):
+            for j, v in enumerate(r):
+                X[i, j] = maps[j][v]
+        enc[sp] = (X, labels[sp], users[sp])
+    return enc, offset
 
 
