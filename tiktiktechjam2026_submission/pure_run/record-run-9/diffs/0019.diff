+def read_ips_weights(data_dir, train_rows, clip_lo=0.25, clip_hi=4.0, alpha=20.0):
+    """Estimate target/logged exposure ratio by video using log_random only as exposure data."""
+    logc=Counter(int(r[2]) for r in train_rows)
+    randc=Counter(); total_r=0
+    for fn in ['log_random_4_22_to_5_08_pure.csv','log_random_4_22_to_5_08.csv']:
+        path=os.path.join(data_dir,fn)
+        if os.path.isfile(path):
+            with open(path,newline='',encoding='utf-8') as f:
+                for rec in csv.DictReader(f):
+                    v=_ival(rec,['video_id','photo_id','video'],None)
+                    if v is not None:
+                        randc[int(v)]+=1; total_r+=1
+            break
+    if total_r<=0:
+        return np.ones(len(train_rows),dtype=np.float32)
+    vids=set(logc.keys())|set(randc.keys()); V=max(1,len(vids)); total_l=sum(logc.values())
+    ratio={}
+    for v in vids:
+        p_r=(randc.get(v,0)+alpha)/(total_r+alpha*V)
+        p_l=(logc.get(v,0)+alpha)/(total_l+alpha*V)
+        ratio[v]=p_r/p_l
+    w=np.asarray([ratio.get(int(r[2]),1.0) for r in train_rows],dtype=np.float64)
+    w=np.clip(w,clip_lo,clip_hi)
+    w=w/(w.mean()+1e-12)
+    return w.astype(np.float32)
 
