+def _ctr(pos, neg, prior=0.37, alpha=8.0):
+    return (pos + alpha * prior) / (pos + neg + alpha)
+
+
+def chronological_history_prior(splits, split):
+    """Prior-only heuristic score in original split order; no valid/test labels used."""
+    up_v = defaultdict(int); un_v = defaultdict(int)
+    up_a = defaultdict(int); un_a = defaultdict(int)
+    up_u = defaultdict(int); un_u = defaultdict(int)
+    up_tab = defaultdict(int); un_tab = defaultdict(int)
+    seen_uv = defaultdict(int); seen_ua = defaultdict(int)
+    out = None
+    for sp in ('train', 'valid', 'test'):
+        vals = []
+        for row in splits[sp]:
+            date, u, v, a, tab, dur, y = row
+            kv = (u, v); ka = (u, a); kt = (u, tab)
+            # Smoothed train-label history, backed off from specific video to author/user/tab.
+            sv = _ctr(up_v[kv], un_v[kv])
+            sa = _ctr(up_a[ka], un_a[ka])
+            su = _ctr(up_u[u], un_u[u])
+            st = _ctr(up_tab[kt], un_tab[kt])
+            # Repeat exposure usually indicates policy interest but too much repetition can fatigue;
+            # cap with log buckets so this is only a close-score tie-breaker.
+            euv = min(1.0, np.log1p(seen_uv[kv]) / np.log(6.0))
+            eua = min(1.0, np.log1p(seen_ua[ka]) / np.log(10.0))
+            vals.append(0.38 * sa + 0.24 * sv + 0.22 * su + 0.10 * st + 0.04 * eua + 0.02 * euv)
+            seen_uv[kv] += 1; seen_ua[ka] += 1
+            if sp == 'train':
+                if y > 0.5:
+                    up_v[kv] += 1; up_a[ka] += 1; up_u[u] += 1; up_tab[kt] += 1
+                else:
+                    un_v[kv] += 1; un_a[ka] += 1; un_u[u] += 1; un_tab[kt] += 1
+        if sp == split:
+            out = np.asarray(vals, dtype=np.float64)
+    return out
+
